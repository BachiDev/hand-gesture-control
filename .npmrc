# vitest 5 wants @types/node ^22||>=24 while the repo pins ^20 (and TF.js pulls
# @types/node-fetch) — a peerOptional conflict plain `npm ci` chokes on.
# One flag for every npm invocation (CI, local, contributors) instead of
# sprinkling --legacy-peer-deps through each workflow step.
legacy-peer-deps=true
